{
  "name": "three-nanite",
  "version": "0.1.0",
  "description": "Nanite-style virtual geometry (cluster LOD DAG) for three.js: an offline GLB preprocessor and a WebGL2 runtime that works with stock materials.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/apekshik/three-nanite.git" },
  "homepage": "https://github.com/apekshik/three-nanite#readme",
  "keywords": ["three", "threejs", "nanite", "virtual-geometry", "cluster-lod", "lod", "meshlets", "meshoptimizer", "webgl"],
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./build": { "types": "./src/build.d.ts", "default": "./src/build.js" },
    "./package.json": "./package.json"
  },
  "bin": { "three-nanite": "bin/three-nanite.mjs" },
  "files": ["src", "bin", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node examples/prepare.mjs && vite examples",
    "sample": "node examples/prepare.mjs --force",
    "test": "node test/smoke.mjs && node test/stream.mjs"
  },
  "peerDependencies": { "three": ">=0.186.0" },
  "dependencies": { "meshoptimizer": "^1.3.0" },
  "devDependencies": { "three": "^0.187.0", "vite": "^8.3.5" }
}
