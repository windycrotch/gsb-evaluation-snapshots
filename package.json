{
  "name": "three-js-editor",
  "description": "A desktop and browser editor for 3D games and web experiences.",
  "homepage": "https://github.com/pthinc/freegameenginethreejs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "node server/start.mjs",
    "build": "vite build",
    "build:desktop": "npm run build:windows",
    "build:windows": "npm run build && electron-builder --win nsis && node desktop/copy-installer.mjs",
    "build:linux": "npm run build && electron-builder --linux AppImage deb",
    "build:mac": "npm run build && electron-builder --mac dmg zip",
    "lint": "eslint .",
    "preview": "node server/start.mjs preview",
    "test": "node --test server/projects.test.mjs && playwright test",
    "test:integration": "node --test server/projects.test.mjs",
    "test:e2e": "playwright test",
    "test:desktop": "node --test desktop/desktop.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.162.0",
    "three-export": "npm:three@0.128.0",
    "troika-three-text": "0.52.3",
    "@react-three/fiber": "^8.15.19",
    "@react-three/drei": "^9.102.3",
    "@react-three/postprocessing": "^2.16.2",
    "@tweenjs/tween.js": "23.1.3",
    "@fontsource/noto-sans": "5.3.0",
    "zustand": "^4.5.2",
    "jquery": "^3.7.1",
    "lottie-web": "^5.13.0",
    "react-colorful": "^5.6.1",
    "react-use-measure": "^2.1.1",
    "jszip": "^3.10.1",
    "@tiptap/react": "^2.2.4",
    "@tiptap/starter-kit": "^2.2.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.1",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "react-hot-toast": "^2.4.1"
  },
  "overrides": {
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.162.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "com.prometech.gameengineeditor",
    "productName": "Game Engine Editor",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "desktop/**/*", "server/**/*", "LICENSE", "license.md", "package.json", "!node_modules/**/*"],
    "extraResources": [
      { "from": "node_modules/three-export/LICENSE", "to": "third-party/three-LICENSE.txt" },
      { "from": "node_modules/@tweenjs/tween.js/LICENSE", "to": "third-party/tween-LICENSE.txt" },
      { "from": "node_modules/three/examples/fonts/droid/NOTICE", "to": "third-party/droid-NOTICE.txt" },
      { "from": "node_modules/@fontsource/noto-sans/LICENSE", "to": "third-party/noto-sans-LICENSE.txt" },
      { "from": "node_modules/troika-three-text/LICENSE", "to": "third-party/troika-three-text-LICENSE.txt" },
      { "from": "node_modules/troika-three-utils/LICENSE", "to": "third-party/troika-three-utils-LICENSE.txt" },
      { "from": "node_modules/troika-worker-utils/LICENSE", "to": "third-party/troika-worker-utils-LICENSE.txt" },
      { "from": "node_modules/webgl-sdf-generator/LICENSE.txt", "to": "third-party/webgl-sdf-generator-LICENSE.txt" },
      { "from": "node_modules/bidi-js/LICENSE.txt", "to": "third-party/bidi-js-LICENSE.txt" }
    ],
    "win": { "target": "nsis", "icon": "desktop/icon.ico", "signAndEditExecutable": true },
    "linux": { "target": ["AppImage", "deb"], "category": "Development", "maintainer": "Game Engine Editor <info@prometech.net.tr>" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "installerIcon": "desktop/icon.ico", "uninstallerIcon": "desktop/icon.ico" }
  }
}