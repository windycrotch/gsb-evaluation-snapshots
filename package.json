{
  "name": "auto-dj-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Local AutoDJ prototype with offline audio analysis and editable live playlist.",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 5173 -d src",
    "backend": ".venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 8765",
    "check:backend": ".venv/bin/python -m pip check && .venv/bin/python -m backend.selfcheck"
  },
  "devDependencies": {
    "puppeteer-core": "^25.1.0"
  }
}
