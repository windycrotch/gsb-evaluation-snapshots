{
  "name": "canvas-video-player",
  "version": "1.0.4",
  "private": false,
  "description": "使用canvas渲染的视频混剪播放器,无缝拼接不同的视频源",
  "author": "ledtwo",
  "main": "lib/canvas-player.umd.min.js",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build --target lib --name canvas-player --dest lib ./src/index.js",
    "lint": "vue-cli-service lint",
    "test": "node test/integration.js"
  },
  "keywords": [
    "video",
    "video-player",
    "canvas",
    "canvas-player"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:ledtwo/canvas-video-player.git"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "babel-eslint": "^10.1.0",
    "core-js": "^3.51.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^24.1.3",
    "less": "^4.9.1",
    "less-loader": "^10.2.0",
    "vue": "^2.6.14",
    "vue-template-compiler": "^2.6.14"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
