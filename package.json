{
	"name": "taro-jiuxiandao",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "九仙道重构版",
	"templateInfo": {
		"name": "default",
		"typescript": true,
		"css": "Less",
		"framework": "React"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build:weapp": "taro build --type weapp",
		"build:swan": "taro build --type swan",
		"build:alipay": "taro build --type alipay",
		"build:tt": "taro build --type tt",
		"build:h5": "taro build --type h5",
		"build:rn": "taro build --type rn",
		"build:qq": "taro build --type qq",
		"build:jd": "taro build --type jd",
		"build:harmony-hybrid": "taro build --type harmony-hybrid",
		"dev": "pnpm dev:h5",
		"build": "pnpm build:h5",
		"typecheck": "tsc --noEmit",
		"format": "prettier \"./src/**/*.{js,jsx,ts,tsx,vue}\" --write",
		"lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
		"dev:weapp": "pnpm run build:weapp --watch",
		"dev:swan": "pnpm run build:swan --watch",
		"dev:alipay": "pnpm run build:alipay --watch",
		"dev:tt": "pnpm run build:tt --watch",
		"dev:h5": "pnpm run build:h5 --watch",
		"dev:rn": "pnpm run build:rn --watch",
		"dev:qq": "pnpm run build:qq --watch",
		"dev:jd": "pnpm run build:jd --watch",
		"dev:harmony-hybrid": "pnpm run build:harmony-hybrid --watch",
		"c:page": "taro create --dir Main/pages"
	},
	"browserslist": [
		"defaults and fully supports es6-module",
		"maintained node versions"
	],
	"author": "xuran",
	"dependencies": {
		"@babel/runtime": "^7.29.14",
		"@icons-pack/react-simple-icons": "^13.15.1",
		"@tarojs/components": "4.3.3",
		"@tarojs/helper": "4.3.3",
		"@tarojs/plugin-framework-react": "4.3.3",
		"@tarojs/plugin-platform-alipay": "4.3.3",
		"@tarojs/plugin-platform-h5": "4.3.3",
		"@tarojs/plugin-platform-harmony-hybrid": "4.3.3",
		"@tarojs/plugin-platform-jd": "4.3.3",
		"@tarojs/plugin-platform-qq": "4.3.3",
		"@tarojs/plugin-platform-swan": "4.3.3",
		"@tarojs/plugin-platform-tt": "4.3.3",
		"@tarojs/plugin-platform-weapp": "4.3.3",
		"@tarojs/react": "4.3.3",
		"@tarojs/runtime": "4.3.3",
		"@tarojs/shared": "4.3.3",
		"@tarojs/taro": "4.3.3",
		"antd-mobile": "^5.43.0",
		"classnames": "^2.5.1",
		"lodash-es": "^4.18.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.13",
		"@babel/plugin-proposal-class-properties": "7.14.5",
		"@babel/plugin-proposal-decorators": "^7.29.7",
		"@babel/preset-react": "^7.29.7",
		"@tarojs/cli": "4.3.3",
		"@tarojs/plugin-doctor": "^0.0.18",
		"@tarojs/plugin-html": "4.3.3",
		"@tarojs/vite-runner": "4.3.3",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^22.20.5",
		"@types/react": "^18.3.31",
		"@typescript-eslint/eslint-plugin": "^8.73.0",
		"@typescript-eslint/parser": "^8.73.0",
		"@vitejs/plugin-react": "^4.7.0",
		"babel-preset-taro": "4.3.3",
		"eslint": "^8.57.1",
		"eslint-config-airbnb": "^19.0.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-config-taro": "4.3.3",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^4.6.2",
		"less": "^4.9.1",
		"postcss": "^8.5.33",
		"prettier": "^3.10.1",
		"react-refresh": "^0.14.2",
		"stylelint": "^16.26.1",
		"terser": "^5.51.3",
		"typescript": "^5.9.3",
		"vite": "^4.5.14"
	},
	"packageManager": "pnpm@12.21.0"
}
