{
  // The site is static files from dist/, served by Cloudflare's CDN directly.
  // worker/index.ts only runs for paths that aren't static assets (here: /api/event).
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths → dist/404.html (instead of an empty response)
    "not_found_handling": "404-page",
    // /api/* always goes to the Worker, before asset lookup and the 404 page
    "run_worker_first": ["/api/*"]
  },

  // dev: deployed automatically on push to main (Workers Builds), lives on *.workers.dev.
  "name": "typing-reply",
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "pjt_events_dev" }],

  "env": {
    // prod: deployed manually only — GitHub Actions → “Deploy production” → Run workflow.
    "production": {
      "name": "pleasejusttext",
      "workers_dev": false,
      "routes": [
        { "pattern": "pleasejusttext.me", "custom_domain": true },
        { "pattern": "www.pleasejusttext.me", "custom_domain": true }
      ],
      "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "pjt_events" }]
    }
  }
}
